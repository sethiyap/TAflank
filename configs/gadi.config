// Gadi (NCI). PBS Pro. Standard compute queues have NO outbound network, so
// the Nextflow head job must run on a login node (tmux) or in copyq, and any
// container image / NCBI fetch must be staged BEFORE the run.
// Reserved for the Stage 9 sweep, not day-to-day development.
params {
    blast_bin    = ''
    python_exec  = 'python3'
    offline_meta = true        // no E-utilities from a compute node
}
apptainer { enabled = true; autoMounts = true; cacheDir = "/scratch/$System.env.PROJECT/.apptainer" }
process {
    executor      = 'pbspro'
    queue         = 'normal'
    cpus          = 4
    memory        = '16 GB'
    time          = '2h'
    clusterOptions = "-P $System.env.PROJECT -l storage=scratch/$System.env.PROJECT+gdata/$System.env.PROJECT"
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
    container     = 'quay.io/biocontainers/blast:2.17.0--h66d330f_0'
}
