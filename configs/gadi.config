// TAflank on Gadi (NCI).
//
// VERIFIED against this project's own working Gadi config,
//   /g/data/rg42/bactopia-workbench/scripts/nextflow.gadi.all_tools.config
// rather than guessed. Differences from a generic PBS setup that matter:
//   - the module is `singularity`, NOT `apptainer`
//   - ncpus/mem/walltime go in clusterOptions explicitly, not only in the
//     Nextflow directives
//   - storage must name every filesystem the job touches, or the job starts
//     and then cannot see /scratch or /g/data
//
// Standard compute queues have NO outbound network. The Nextflow head job must
// therefore run on a login node (tmux) or in copyq, and anything needing the
// internet -- container pulls, NCBI metadata -- must be staged beforehand.
// That is why params.meta_source defaults to 'blast' here.

params {
    project      = System.getenv('PROJECT') ?: 'rg42'
    storage      = System.getenv('TAFLANK_STORAGE') ?: 'scratch/rg42+gdata/rg42'
    blast_bin    = ''          // from the module / container, resolved via PATH
    python_exec  = 'python3'
    meta_source  = 'blast'     // no E-utilities from a compute node
    blast_cpus   = 8
    blast_task   = 'megablast' // see PIPELINE_DESCRIPTION.md, "Bait search at sweep scale"

    // PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY import matplotlib(+scipy).
    // Same pattern as Bakta: a container, pulled once on copyq where there
    // is network (env/gadi_viz_setup.sh), because compute nodes have none.
    // False by DEFAULT here for the same reason run_bakta defaults to
    // false -- turning it on needs that one-time setup to have already
    // happened, or singularity tries to pull on a compute node and fails.
    // env/gadi_run.sh's VIZ=true flips this on together with
    // --viz_container, exactly how BAKTA=true already does for Bakta; see
    // withLabel: 'viz' below for where that container is actually applied.
    // Until it is on, PANGRAPH_BLOCKS still runs and still produces its TSV
    // tables (including pangraph_pairwise.tsv, which PANGRAPH_GROUPS needs)
    // -- only the .png/.svg figure is skipped.
    run_viz = false
    // Same reasoning, for the pangraph binary instead of a container:
    // env/gadi_pangraph_setup.sh pulls it once, on copyq; false here until
    // that has happened, flipped back on by env/gadi_run.sh's PANGRAPH=true.
    run_pangraph = false
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('SING_CACHE')
                 ?: "/scratch/${System.getenv('PROJECT') ?: 'rg42'}/${System.getenv('USER')}/singularity_cache"
}

process {
    executor   = 'pbspro'
    queue      = 'normal'
    cpus       = 4
    memory     = 16.GB
    time       = 4.h
    maxForks   = 8

    beforeScript = '''
module purge
module load singularity
module load blast/2.11.0 2>/dev/null || true
export TERM="${TERM:-dumb}"
'''

    clusterOptions = { "-P ${params.project} -l ncpus=${task.cpus},mem=${task.memory.toMega()}mb,walltime=${task.time.toSeconds()/3600 as int}:00:00,jobfs=10GB,storage=${params.storage}" }

    // Transient Singularity faults -- most often "failed to find loop device"
    // when several containers mount on one node -- surface as 125/126/255 and
    // should not kill the run. Everything else terminates, per Nextflow default.
    errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
    maxRetries    = 3

    // The bait search against nt_prok is the one heavy step: 502.7 Gbp, and the
    // database is read straight off /g/data or /scratch rather than staged.
    withName: 'BAIT_SEARCH' {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }
    withName: 'IS_SEARCH|PLASMIDFINDER' {
        cpus   = 2
        memory = 8.GB
        time   = 1.h
    }
    // Bakta is the only containerised step. Without this the process would
    // start and fail with "bakta: command not found", because the Gadi module
    // system has no bakta module.
    // params.bakta_container must be a LOCAL .sif path on Gadi, not a
    // docker:// URI. Compute nodes have no outbound network, so Nextflow
    // cannot pull; env/gadi_bakta_setup.sh pulls it from copyq instead and
    // env/gadi_run.sh passes the resulting file through.
    withLabel: 'bakta' {
        container = params.bakta_container
        cpus      = 4
        memory    = 16.GB
        time      = 2.h
    }
    // PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY, same container-pull
    // reasoning as bakta above (env/gadi_viz_setup.sh, env/gadi_run.sh's
    // VIZ_SIF). Only takes effect when run_viz=true actually runs these --
    // a container directive on a `when: false`-skipped process is never
    // pulled or exec'd.
    withLabel: 'viz' {
        container = params.viz_container
        cpus      = 1
        memory    = 8.GB
        time      = 1.h
    }
    // Pure-Python table steps: trivial, and queueing them costs more than running.
    withName: 'SELECT_LOCI|COLLATE|FETCH_METADATA' {
        executor = 'local'
    }
}
