// Firefly (CIDM). Apptainer available -- which is the whole point of moving
// here: amrfinderplus and keras have NO macOS builds, so Bakta and geNomad are
// impossible locally but fine in a linux-amd64 container.
//
// UNVERIFIED until env/firefly_probe.sh has been run: executor name, queue
// names, and whether compute nodes have outbound network. Adjust from the
// probe output rather than guessing.
params {
    blast_bin   = ''            // from the container
    python_exec = 'python3'
    // Same reasoning as configs/gadi.config: the biocontainer withLabel:
    // python below (quay.io/biocontainers/python:3.12) is bare Python, no
    // matplotlib/scipy. PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY use
    // label 'viz', NOT label 'python', specifically so they do not silently
    // inherit that container. A `withLabel: 'viz'` entry below now points
    // at the SAME jupyter/scipy-notebook image env/gadi_viz_setup.sh uses
    // on Gadi -- still left FALSE here, though, because unlike Gadi this
    // has not actually been pulled-and-smoke-tested on Firefly: run
    // env/firefly_probe.sh first (outbound network from compute nodes is
    // itself unconfirmed, per this file's own header), then flip true once
    // a real run confirms apptainer can pull it. Until then PANGRAPH_BLOCKS
    // still produces its TSV tables; only the figure is skipped, same as
    // on Gadi before its setup script ran.
    run_viz = false
    // Same status as run_viz above: pangraph is a single native
    // Linux binary (no container needed for the binary itself), but
    // getting it onto Firefly at all needs outbound network from
    // SOMEWHERE on this cluster, which env/firefly_probe.sh has not yet
    // confirmed exists. False until env/firefly_pangraph_setup.sh has
    // actually been run and verified.
    run_pangraph = false
}
apptainer { enabled = true; autoMounts = true; cacheDir = "$HOME/.apptainer/cache" }
process {
    executor      = 'slurm'     // CONFIRM with the probe (could be PBS: 'pbspro')
    cpus          = 2
    memory        = '8 GB'
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
    container     = 'quay.io/biocontainers/blast:2.17.0--h66d330f_0'
    withLabel: python { container = 'quay.io/biocontainers/python:3.12' }
    // Same image choice as env/gadi_viz_setup.sh, for the same reason
    // (matplotlib+scipy+openpyxl, zero-build pull) -- NOT yet confirmed
    // pullable via apptainer on this cluster specifically.
    withLabel: viz    { container = 'jupyter/scipy-notebook:latest' }
}
