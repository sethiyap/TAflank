// arm64 macOS laptop. NATIVE tools, deliberately NO containers:
// biocontainers are linux-amd64 and this machine's Docker daemon is off.
// Homebrew here is x86_64/Rosetta, so brew's BLAST would be a DOWNGRADE from
// the native arm64 BLAST 2.17.0 that produced every verified result so far.
params {
    blast_bin   = '/Users/pooja/opt/ncbi-blast-2.17.0+/bin'
    python_exec = '/usr/bin/python3'
    // base Anaconda python, called directly rather than through the shell's
    // `conda` function -- that function is broken here (__conda_exe:
    // permission denied), but the interpreter it would have activated runs
    // fine invoked by its own path. Has matplotlib; /usr/bin/python3 above
    // does not. See PY_VIZ() in main.nf.
    viz_python_exec = '/opt/anaconda3/bin/python3.12'
    // Pangraph 1.4.0, native arm64 Rust binary from
    // github.com/neherlab/pangraph/releases -- no Julia, no conda env,
    // just a single pinned executable, same pattern as blast_bin.
    pangraph_bin = '/Users/pooja/opt/pangraph-1.4.0/bin'
}
process {
    executor      = 'local'
    cpus          = 1
    errorStrategy = 'terminate'
    beforeScript  = "export PATH=\"${params.blast_bin}:\$PATH\""
}
executor { $local { cpus = 8; memory = '12 GB' } }
