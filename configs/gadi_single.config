// TAflank on Gadi, whole pipeline inside ONE PBS job.
//
// Use this for curated sets (tens of loci). Nextflow runs with the `local`
// executor INSIDE the job, so there is no head job to keep alive, no nested
// submission, and no walltime coordination between head and tasks.
//
// Use `-profile gadi` instead for the nt_prok sweep, where tasks must fan out
// across nodes -- that one needs the head process on a login node or copyq,
// because standard compute queues have no outbound network.

params {
    blast_bin    = ''           // module load blast/2.11.0 puts it on PATH
    python_exec  = 'python3'
    meta_source  = 'blast'      // no E-utilities from a compute node
    gbk_dir      = ''           // no local GenBank on the cluster by default
}

process {
    executor      = 'local'
    cpus          = 2
    errorStrategy = 'terminate'

    withName: 'BAIT_SEARCH'  { cpus = 8 }
    withName: 'BAKTA'        { cpus = 4 }
}

executor {
    $local {
        cpus   = System.getenv('PBS_NCPUS')  ? System.getenv('PBS_NCPUS') as int : 8
        memory = System.getenv('PBS_VMEM')   ? "${(System.getenv('PBS_VMEM') as long) / (1024*1024*1024) as int} GB" : '32 GB'
    }
}

singularity {
    enabled    = params.run_bakta as boolean
    autoMounts = true
    cacheDir   = System.getenv('SING_CACHE')
                 ?: "/scratch/${System.getenv('PROJECT') ?: 'rg42'}/${System.getenv('USER')}/singularity_cache"
}
