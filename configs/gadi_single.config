// TAflank on Gadi, whole pipeline inside ONE PBS job.
//
// Use this for curated sets (tens of loci). Nextflow runs with the `local`
// executor INSIDE the job, so there is no head job to keep alive, no nested
// submission, and no walltime coordination between head and tasks.
//
// Use `-profile gadi` instead for the nt_prok sweep, where tasks must fan out
// across nodes -- that one needs the head process on a login node or copyq,
// because standard compute queues have no outbound network.

params {
    blast_bin    = ''           // module load blast/2.11.0 puts it on PATH
    python_exec  = 'python3'
    meta_source  = 'blast'      // no E-utilities from a compute node
    gbk_dir      = ''           // no local GenBank on the cluster by default
    // Overrides nextflow.config's default of true: without this override,
    // a run on this profile with no VIZ_CONTAINER set would try to run
    // PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY against the bare node's
    // python3, which does not have matplotlib, and fail. env/gadi_run.sh's VIZ=true
    // flips this back on together with --viz_container, exactly how BAKTA=
    // true already does for run_bakta.
    run_viz = false
    // Same reasoning, for the pangraph binary instead of a container: a
    // bare pinned executable (env/gadi_pangraph_setup.sh), not guaranteed
    // present without that one-time setup, so BUILD_PANGRAPH_GRAPH (and
    // everything downstream of it) is off until env/gadi_run.sh's
    // PANGRAPH=true flips it back on together with --pangraph_bin.
    run_pangraph = false
}

process {
    executor      = 'local'
    cpus          = 2
    errorStrategy = 'terminate'

    withName: 'BAIT_SEARCH'  { cpus = 8 }
    withName: 'BAKTA'        { cpus = 4 }
}

executor {
    $local {
        cpus   = System.getenv('PBS_NCPUS')  ? System.getenv('PBS_NCPUS') as int : 8
        memory = System.getenv('PBS_VMEM')   ? "${(System.getenv('PBS_VMEM') as long) / (1024*1024*1024) as int} GB" : '32 GB'
    }
}

process {
    // Bakta and the viz (matplotlib+scipy) stage are the only steps that
    // need a container here; everything else runs from the modules loaded
    // by env/gadi_run.sh.
    // params.bakta_container / params.viz_container must be LOCAL .sif
    // paths on Gadi, not docker:// URIs. Compute nodes have no outbound
    // network, so Nextflow cannot pull; env/gadi_bakta_setup.sh and
    // env/gadi_viz_setup.sh pull them from copyq instead and
    // env/gadi_run.sh passes the resulting files through.
    withLabel: 'bakta' { container = params.bakta_container }
    withLabel: 'viz'   { container = params.viz_container }
}

singularity {
    enabled    = (params.run_bakta as boolean) || (params.run_viz as boolean)
    autoMounts = true
    cacheDir   = System.getenv('SING_CACHE')
                 ?: "/scratch/${System.getenv('PROJECT') ?: 'rg42'}/${System.getenv('USER')}/singularity_cache"
}
