// TAflank -- Nextflow DSL2
// Portable from day one: `local` runs natively on the arm64 laptop, `firefly`
// and `gadi` run the same processes from containers on Linux.

nextflow.enable.dsl = 2
manifest {
    name            = 'TAflank'
    description     = 'Bait-anchored discovery of mobile genetic elements in gene flanking regions'
    homePage        = 'https://github.com/sethiyap/TAflank'
    author          = 'Pooja Sethiya'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    // ---- bait: a parameter, not a hardcoded gene ----
    bait          = "${projectDir}/anchors/relBE_seed.fa"
    subregions    = 'relB:1-240,relE:240-527'   // '' for a bait with no named parts

    // ---- search space ----
    genome_dir    = "${projectDir}/data/public_16/fasta"
    db_name       = 'public16'

    // Pre-formatted database (update_blastdb.pl nt_prok nt_viruses taxdb).
    // Set --blastdb to its absolute path WITHOUT file extensions, e.g.
    //   --blastdb /scratch/$PROJECT/blastdb/nt_prok
    // Setting it skips BUILD_DB entirely and the db is never staged.
    blastdb       = ''
    taxonomy      = false        // request staxids/sscinames (needs taxdb)
    max_target_seqs = 100000     // NOT top-N; it prunes during search
    blast_cpus    = 1

    // where record metadata comes from: ncbi | cache | blast
    //   blast => parsed from the BLAST stitle/slen columns, NO network
    meta_source   = 'ncbi'
    meta_cache    = "${projectDir}/data/metadata_cache"

    // ---- Tier A: sequence filters ----
    full_pident   = 95
    full_qcov     = 95
    paralogue_max_pident = 85
    blast_task    = 'blastn'     // NOT megablast: misses 85-92% diverged copies
    evalue        = '1e-5'

    // ---- Tier B: record filters ----
    replicon_type = 'plasmid'    // '' keeps all; 'plasmid,chromosome' for both
    tier_a        = 'FULL'
    min_flank     = 0            // 0 => keep short-flank loci and record them

    // ---- F2: window ----
    flank         = 20000

    // ---- F4 layer 2: ISfinder. min_length MUST stay 0 ----
    isfinder_db   = "${projectDir}/db/isfinder/ISfinder"
    is_min_length = 0
    is_evalue     = '1e-3'
    is_max_target = 10000        // above the 5,970-seq db; max_target_seqs is
                                 // not a top-N filter, it prunes during search

    // ---- F4 layer 5: PlasmidFinder (Acman et al. 2022 thresholds) ----
    plasmidfinder_fa = "${projectDir}/db/plasmidfinder/plasmidfinder.fa"
    pf_min_cov    = 80
    pf_min_id     = 95

    outdir        = "${projectDir}/results"
    loci_dir      = "${projectDir}/loci/plasmids"
    tracedir      = "${params.outdir}/pipeline_info"
}

// Derived once, so processes do not each re-decide.
params.blastdb_path    = params.blastdb ?: params.db_name
params.use_blastdb_seq = (params.blastdb != null && params.blastdb != '')

profiles {
    local   { includeConfig 'configs/local.config'   }
    firefly { includeConfig 'configs/firefly.config' }
    gadi    { includeConfig 'configs/gadi.config'    }
}

report   { enabled = true; overwrite = true; file = "${params.tracedir}/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.tracedir}/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.tracedir}/trace.txt"     }
