// TAflank -- Nextflow DSL2
// Portable from day one: `local` runs natively on the arm64 laptop, `firefly`
// and `gadi` run the same processes from containers on Linux.

nextflow.enable.dsl = 2
manifest {
    name            = 'TAflank'
    description     = 'Bait-anchored discovery of mobile genetic elements in gene flanking regions'
    homePage        = 'https://github.com/sethiyap/TAflank'
    author          = 'Pooja Sethiya'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    help          = false   // --help prints usage (main.nf, top of file) and exits

    // ---- bait: a parameter, not a hardcoded gene ----
    bait          = "${projectDir}/anchors/relBE_seed.fa"
    subregions    = 'relB:1-240,relE:240-527'   // '' for a bait with no named parts

    // ---- search space ----
    genome_dir    = "${projectDir}/data/public_16/fasta"
    db_name       = 'public16'

    // Pre-formatted database (update_blastdb.pl nt_prok nt_viruses taxdb).
    // Set --blastdb to its absolute path WITHOUT file extensions, e.g.
    //   --blastdb /scratch/$PROJECT/blastdb/nt_prok
    // Setting it skips BUILD_DB entirely and the db is never staged.
    blastdb       = ''

    // Import an NCBI web BLAST result instead of searching. Point at a
    // "Hit Table (text)" or "Hit Table (csv)" download; BUILD_DB and
    // BAIT_SEARCH are skipped and windows are fetched from NCBI by accession.
    hit_table     = ''
    efetch_cache  = "${projectDir}/data/efetch_cache"
    taxonomy      = false        // request staxids/sscinames (needs taxdb)
    max_target_seqs = 100000     // NOT top-N; it prunes during search
    blast_cpus    = 1

    // where record metadata comes from: ncbi | cache | blast
    //   blast => parsed from the BLAST stitle/slen columns, NO network
    meta_source   = 'ncbi'
    meta_cache    = "${projectDir}/data/metadata_cache"

    // ---- Tier A: sequence filters ----
    // Two INDEPENDENT reasons to drop a hit: pident answers "is this even
    // the same gene" (paralogy), qcov answers "did the whole bait match"
    // (completeness) -- see scripts/bait_search.py's classification block.
    full_qcov     = 95
    paralogue_max_pident = 90
    blast_task    = 'blastn'     // NOT megablast: misses 85-92% diverged copies
    evalue        = '1e-5'

    // ---- Tier B: record filters ----
    // Use the literal `all` to disable a filter, NOT '' -- Nextflow turns an
    // empty CLI value into boolean true, which then matches nothing.
    replicon_type = 'plasmid'    // 'all' keeps every replicon type
    tier_a        = 'FULL'       // 'all' keeps paralogues/incomplete too, classified later
    min_flank     = 0            // 0 => keep short-flank loci and record them

    // ---- F2: window. Flank size is ONE parameter, consumed by SELECT_LOCI,
    // EXTRACT_LOCI, and the pangraph (sequence-homology) stages alike -- never
    // override it on just one of those, or extraction and analysis drift out
    // of sync with each other. ----
    flank         = 20000

    // ---- pangraph: sequence-homology blocks (CLAUDE.md Stage 5's "careful
    // pass"), using a true N-way alignment graph (Noll, Molari & Neher 2023)
    // built from the SAME filtered, extracted loci windows. pangraph_bin
    // empty here (local profile has its own in configs/local.config);
    // gadi/firefly point this at the binary env/gadi_pangraph_setup.sh (or
    // the Firefly equivalent) pulls, same reasoning as blast_bin.
    pangraph_bin = ''
    pangraph_min_similarity = 0.85   // groups.py grouping threshold on shared_frac
    // Row HEIGHT (and label font) multiplier for pangraph_blocks.png --
    // 0.5 packs rows tight so many loci still fit in one figure; see
    // scripts/pangraph_blocks.py's own --row-scale help text.
    pangraph_row_scale = 0.5
    // Mirrors run_bakta: pangraph is a single pinned binary (not a module,
    // not guaranteed present), so BUILD_PANGRAPH_GRAPH is gated the same
    // way BAKTA is -- true by default (this laptop has it installed);
    // gadi.config/gadi_single.config/firefly.config set it false until the
    // one-time setup (env/gadi_pangraph_setup.sh) has actually run there.
    // Gating only BUILD_PANGRAPH_GRAPH is enough: every downstream pangraph
    // process takes its graph.json as a real channel input, so an empty
    // upstream channel cascades to "never runs" automatically, with no
    // separate `when:` needed on each one.
    run_pangraph = true

    // ---- F4 layer 2: ISfinder. min_length MUST stay 0 ----
    isfinder_db   = "${projectDir}/db/isfinder/ISfinder"
    is_min_length = 0
    is_evalue     = '1e-3'
    is_max_target = 10000        // above the 5,970-seq db; max_target_seqs is
                                 // not a top-N filter, it prunes during search

    // ---- annotation: complementary to ISfinder, not an alternative ----
    // Bakta names IS elements by FAMILY only ("ISNCY family transposase"), so
    // it cannot identify the vehicle; ISfinder does that by homology. Both
    // feed GENE_BLOCKS, where the element name wins on >=50% overlap.
    run_bakta     = false        // needs amrfinderplus: cluster only
    // Mirror image of run_bakta: matplotlib+scipy are verified on THIS
    // laptop (configs/local.config's viz_python_exec) and, via a pulled
    // container, on Gadi (env/gadi_viz_setup.sh + configs/gadi.config's
    // withLabel: viz). True by default. firefly.config still sets it false
    // until an equivalent container is confirmed there -- same reasoning
    // that has always kept colour_blocks.py itself out of this Nextflow
    // graph until one is.
    run_viz = true
    bakta_db      = ''
    // Newest biocontainers tag, checked against the quay.io tag list rather
    // than guessed. Only used by the firefly/gadi profiles; the local profile
    // runs no containers at all.
    bakta_container = 'quay.io/biocontainers/bakta:1.12.2--pyhdfd78af_0'
    bakta_args    = '--skip-plot --skip-crispr'
    gbk_dir       = "${projectDir}/data/public_16/gbk"
    // matplotlib+scipy for PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY on a
    // cluster profile. Empty on local (no container there at all -- see
    // configs/local.config's viz_python_exec instead); gadi.config points
    // this at the .sif env/gadi_viz_setup.sh pulls.
    viz_container = ''

    // ---- Tier C: the elements that bracket the core ----
    // LINEAGE-SPECIFIC. ISEsa1/ISEsa2 flank the relBE metal-resistance core;
    // a different bait needs different ends or every locus reports VEHICLE-ABSENT.
    vehicle_ends  = 'ISEsa1,ISEsa2'

    // ---- Tier C: cargo context. Recorded, NEVER a membership criterion ----
    cargo_fa          = "${projectDir}/assets/cargo_genes.fa"
    cargo_min_pident  = 80
    cargo_min_cov     = 50

    // ---- F4 layer 5: PlasmidFinder (Acman et al. 2022 thresholds) ----
    plasmidfinder_fa = "${projectDir}/db/plasmidfinder/plasmidfinder.fa"
    pf_min_cov    = 80
    pf_min_id     = 95

    outdir        = "${projectDir}/results"
    loci_dir      = "${projectDir}/loci/plasmids"
    figdir        = "${projectDir}/figures"   // PANGRAPH_BLOCKS/PANGRAPH_ANNOTATED/PANGRAPH_CONTEXT_SUMMARY .png/.svg
    tracedir      = "${params.outdir}/pipeline_info"
}

// A hit table carries no stitle, so metadata cannot be parsed from it.
if (params.hit_table) params.meta_source = 'ncbi'

// Derived once, so processes do not each re-decide.
params.blastdb_path    = params.blastdb ?: params.db_name
params.use_blastdb_seq = (params.blastdb != null && params.blastdb != '')

profiles {
    local   { includeConfig 'configs/local.config'   }
    firefly { includeConfig 'configs/firefly.config' }
    gadi        { includeConfig 'configs/gadi.config'        }  // fan out across nodes
    gadi_single { includeConfig 'configs/gadi_single.config' }  // all in one PBS job
}

report   { enabled = true; overwrite = true; file = "${params.tracedir}/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.tracedir}/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.tracedir}/trace.txt"     }
